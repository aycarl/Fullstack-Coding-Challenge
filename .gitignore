# --- Node / frontend (boilerplate + any generated app) ---
node_modules
dist
.vite
coverage
*.tsbuildinfo

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python / agent ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Agent run artifacts ---
*.log

# Run logs. One is committed as evidence of the task decomposition; the rest
# are local noise. Must be logs/* and not logs/ — git cannot re-include a file
# that sits inside an excluded directory, so a trailing slash kills the negation.
agent/logs/*
!agent/logs/sample-run.txt

# Run lock, written beside the output directory while a run holds it.
agent/*.lock

# --- OS / editor cruft ---
*.local
.DS_Store

# Agent output. The sample run in agent/generated-app/ is committed deliberately as
# evidence that the pipeline produces a runnable project; its node_modules and build
# output are already covered by the rules at the top of this file.
