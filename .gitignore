# --- Node / frontend (boilerplate + any generated app) ---
node_modules
dist
.vite
coverage
*.tsbuildinfo

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python / agent ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Agent run artifacts ---
*.log

# Run logs. One is committed as evidence of the task decomposition; the rest
# are local noise. Must be logs/* and not logs/ — git cannot re-include a file
# that sits inside an excluded directory, so a trailing slash kills the negation.
agent/logs/*
!agent/logs/sample-run.txt

# --- OS / editor cruft ---
*.local
.DS_Store

# Agent output (a sample run is committed deliberately at Stage 4)
agent/generated-app/
