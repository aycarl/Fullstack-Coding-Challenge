# Copy to agent/.env and fill in your key.
#
# The agent uses Anthropic only — one key is all it needs.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Point the whole pipeline at a different model without editing code.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Used only to price a run in the CLI summary, in USD per million
# tokens. Override these if you change the model above.
# ANTHROPIC_INPUT_COST_PER_MTOK=5.00
# ANTHROPIC_OUTPUT_COST_PER_MTOK=25.00
